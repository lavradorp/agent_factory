# Copy this file to .env and fill in the values you need for the providers
# you're actually using. .env is gitignored and load_dotenv() (main.py)
# reads it automatically on startup. Never commit real secrets.

# --- LLM / embeddings providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
NOMIC_API_KEY=

# --- Vector store providers (only cloud engines need a key) ---
PINECONE_API_KEY=
QDRANT_API_KEY=

# Postgres credentials for the checkpointer are NOT read from env — they go
# straight into the agent YAML's `checkpointer.connection_path` as a full
# connection string (see docker-compose.yml for local dev defaults).
